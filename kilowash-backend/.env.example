PORT=3000
NODE_ENV=development

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:port/database

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=8h

# WhatsApp API (Fonnte)
WA_API_URL=https://api.fonnte.com/send
WA_TOKEN=your_fonnte_token_here
WA_SENDER=628xxxxxxxxxx

# v2: URL frontend untuk link tracking di notifikasi WA
TRACKING_BASE_URL=https://your-frontend.vercel.app

# v2: Konfigurasi Loyalty Points
# 1 poin diberikan setiap kelipatan LOYALTY_POINTS_PER_RUPIAH
LOYALTY_POINTS_PER_RUPIAH=10000
# Nilai 1 poin dalam Rupiah saat ditukar (redeem)
LOYALTY_POINT_VALUE=1000
